{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BasicAuth": {
    "Realm": "TopinLite",
    "ReturnJsonBody": true,
    "LogFailures": true,
    "ExcludedPaths": [
      "/health",
      "/swagger",
      "/favicon.ico",
      "/",
      "/RequestOrder"
    ]
  },
  "RabbitConfig": {
    "RabbitConnection": {
      "HostAddress": "172.18.63.44",
      "PortNumber": 5672,
      "Username": "guest",
      "Password": "guest",
      "ClientName": "TopiLite.Edge"
    },
    "HttpCallLog": {
      "ExchangeName": "topinlite-edge-exchange-log",
      "QueueName": "topinlite-edge-queue-http-log",
      "RoutingKey": "topinlite-edge-route-http-log",
      "QueueDurable": true,
      "QueueAutoDelete": false,
      "ExchangeDurable": true,
      "ExchangeAutoDelete": false
    },
    "UserActivityLog": {
      "ExchangeName": "topinlite-edge-exchange-log",
      "QueueName": "topinlite-edge-queue-user-activity-log",
      "RoutingKey": "topinlite-edge-route-user-activity-log",
      "QueueDurable": true,
      "QueueAutoDelete": false,
      "ExchangeDurable": true,
      "ExchangeAutoDelete": false
    },
    "ErrorLog": {
      "ExchangeName": "topinlite-edge-exchange-log",
      "QueueName": "topinlite-edge-queue-error-log",
      "RoutingKey": "topinlite-edge-route-error-log",
      "QueueDurable": true,
      "QueueAutoDelete": false,
      "ExchangeDurable": true,
      "ExchangeAutoDelete": false
    }
  },
  "PostgresTraffic": {
    "ConnectionString": "Host=...;Port=5432;Database=topinlite;Username=...;Password=...",
    "ServerName": "topinlite-edge",
    "EnvironmentName": "Production",
    "ExcludedPaths": [
      "/health",
      "/metrics",
      "/favicon.ico",
      "/swagger"
    ]
  }
}
